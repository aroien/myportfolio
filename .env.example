# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority"

# Admin login for /admin
ADMIN_EMAIL="admin@mmehedi.me"
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# Signs the admin session cookie. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Public URL of the site (used for SEO metadata)
NEXT_PUBLIC_SITE_URL="https://mmehedi.me"

